# JKAnimeNuvio: configuración local.
# Copia este archivo como .env y rellena SOLO lo que necesites.
# Nunca subas .env a GitHub ni lo muestres en capturas de pantalla.
# Todas las variables son opcionales: un proveedor sin credenciales se omite.

# Puerto del servidor local (por defecto 3000)
PORT=3000

# TMDB: usa el "API Read Access Token" (recomendado) o la "API Key" v3.
# https://www.themoviedb.org/settings/api
TMDB_API_READ_TOKEN=
TMDB_API_KEY=

# TheTVDB API v4. El PIN solo hace falta con claves de tipo suscriptor.
# https://thetvdb.com/api-information
TVDB_API_KEY=
TVDB_SUBSCRIBER_PIN=

# auto = TMDB, luego TVDB, más Cinemeta. O solo uno: tmdb | tvdb | cinemeta
METADATA_PROVIDER=auto
# Cinemeta es opcional; con false la numeración por defecto pasa a TMDB/TVDB.
CINEMETA_ENABLED=true
# Bases de relaciones (yuna, ani.zip); solo se usan como pistas que se verifican.
RELATIONS_ENABLED=true

# --- Avanzado (normalmente no hace falta tocarlo) ---
# HOST=0.0.0.0
# JKANIME_BASE=https://jkanime.net
# CINEMETA_BASE=https://v3-cinemeta.strem.io
# HTTP_TIMEOUT_MS=10000
# TMDB_TIMEOUT_MS=8000
# TVDB_TIMEOUT_MS=8000
# CINEMETA_TIMEOUT_MS=8000
# ANILIST_TIMEOUT_MS=8000
# KITSU_TIMEOUT_MS=8000
# RELATIONS_TIMEOUT_MS=6000
# EXTRACT_TIMEOUT_MS=12000
# STREAM_TIMEOUT_MS=25000
# Búsqueda en JKAnime: consultas máximas por petición, simultáneas y tiempo máximo.
# JK_MAX_QUERIES=8
# JK_SEARCH_CONCURRENCY=2
# JK_SEARCH_BUDGET_MS=10000
# Peticiones simultáneas a JKAnime (total), por servidor y en total.
# JK_CONCURRENCY=3
# HTTP_MAX_PER_HOST=4
# HTTP_MAX_CONCURRENCY=16
# true = comprobar cada enlace (lista HLS o 1 byte del MP4) antes de mostrarlo.
# STREAM_PROBE=false

# --- Instancia en la nube (Koyeb u otra) ---
# Ninguna hace falta en Termux ni en tu computadora. Ver "Despliegue en Koyeb" en el README.
# Token privado: el addon solo responde bajo /TOKEN/manifest.json (sin él, 404; /health
# sigue libre). Solo letras, números y - _ . ~ ; al menos 16 caracteres aleatorios.
# ADDON_TOKEN=
# Peticiones máximas por IP y minuto (sin definir = sin límite).
# RATE_LIMIT_PER_MIN=60
# Detrás de un proxy (Koyeb): true, número de saltos o subredes, para ver la IP real.
# TRUST_PROXY=true
# Dirección pública que muestra la página de inicio (si no, X-Forwarded-Proto/Host).
# PUBLIC_URL=https://mi-app.koyeb.app
# true = activa /status (bajo el token): versión, memoria, cachés y estado de JKAnime.
# STATUS_ENABLED=false
# Máximo de entradas de cada caché en memoria (solo reduce los máximos internos).
# CACHE_MAX_ENTRIES=300
# Tiempo máximo para terminar las peticiones en curso al apagar.
# SHUTDOWN_TIMEOUT_MS=10000
# Valores recomendados para 0,1 vCPU / 512 MB: JK_CONCURRENCY=2, HTTP_MAX_CONCURRENCY=8,
# HTTP_MAX_PER_HOST=3, CACHE_MAX_ENTRIES=300, STREAM_PROBE=false.
