# Port for the HTTP server (default 3000)
PORT=3000
# Optional: TMDB v4 read token. Enables tmdb: ids and the numbering=tmdb config
# (/numbering=tmdb/manifest.json) for clients that number episodes like TMDB.
TMDB_API_READ_TOKEN=
# Optional: JKAnime base URL (default https://jkanime.net)
JKANIME_BASE=https://jkanime.net
# Optional timeouts in ms
HTTP_TIMEOUT_MS=10000
EXTRACT_TIMEOUT_MS=12000
STREAM_TIMEOUT_MS=25000
