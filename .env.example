# Copy to .env and fill in your own values. Never commit .env.
# Every variable is optional; providers without credentials are skipped.

PORT=3000

# --- Metadata providers (identification only, never a stream source) ---
# TMDB: read access token (v4, preferred, sent as Bearer) or v3 API key.
TMDB_API_READ_TOKEN=your-tmdb-read-access-token
TMDB_API_KEY=your-tmdb-v3-api-key
# TheTVDB API v4: project key, plus subscriber PIN only for user-supported keys.
TVDB_API_KEY=your-tvdb-v4-api-key
TVDB_SUBSCRIBER_PIN=
# auto = TMDB, then TVDB, plus Cinemeta. Or restrict to one: tmdb | tvdb | cinemeta
METADATA_PROVIDER=auto
# Cinemeta stays optional; with false the default numbering becomes TMDB/TVDB.
CINEMETA_ENABLED=true
# Community id relation databases (yuna, ani.zip); only used as cross-checked claims.
RELATIONS_ENABLED=true

# --- JKAnime ---
JKANIME_BASE=https://jkanime.net

# --- Timeouts (ms) ---
HTTP_TIMEOUT_MS=10000
TMDB_TIMEOUT_MS=8000
TVDB_TIMEOUT_MS=8000
CINEMETA_TIMEOUT_MS=8000
ANILIST_TIMEOUT_MS=8000
KITSU_TIMEOUT_MS=8000
RELATIONS_TIMEOUT_MS=6000
EXTRACT_TIMEOUT_MS=12000
STREAM_TIMEOUT_MS=25000
