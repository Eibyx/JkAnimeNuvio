  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node index.js",
    "test": "node --test",
    "live-check": "node scripts/live-check.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Eibyx/JkAnimeNuvio.git"
  },
  "keywords": [
    "stremio",
