  ],
  "author": "Eibyx (based on animeflv-stremio-addon by Pigamer37)",
  "license": "MIT",
  "dependencies": {
    "cheerio": "^1.1.2",
    "dotenv": "^16.5.0",
    "express": "^4.21.1",
    "unpacker": "^1.0.1"
  }
