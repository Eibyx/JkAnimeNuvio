# Anime Catalog Generator: configuración local.
# Copia este archivo como .env (en la carpeta anime-catalog-generator/) y rellena lo que necesites.
# Nunca subas .env a GitHub. En GitHub Actions usa Secrets.

# MDBList: obligatoria solo para ESCRIBIR listas (--apply). Sin ella puedes simular con --dry-run.
# https://mdblist.com/preferences/  -> sección "API Access"
MDBLIST_API_KEY=

# TMDB (recomendada): valida que cada ID exista y corresponda al anime (año, título, IDs externos)
# y habilita los fallbacks por TVDB/IMDb y por título. Usa la API Key v3 o el Read Access Token v4.
# https://www.themoviedb.org/settings/api
TMDB_API_KEY=
TMDB_READ_ACCESS_TOKEN=

# TheTVDB v4 (opcional): no hace falta para el flujo normal; los TVDB IDs salen de los mappings.
TVDB_API_KEY=
TVDB_SUBSCRIBER_PIN=

# APIs públicas (sin autenticación)
ANILIST_API_URL=https://graphql.anilist.co
JIKAN_API_URL=https://api.jikan.moe/v4

# Almacenamiento local
DATABASE_PATH=data/anime_catalog.db
# DATASETS_DIR=data/datasets
# REPORTS_DIR=reports
# OVERRIDES_PATH=overrides.yaml

LOG_LEVEL=INFO

# Si no se indica --apply ni --dry-run (ni mdblist.dry_run en el YAML), se simula.
DEFAULT_DRY_RUN=true
